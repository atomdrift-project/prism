[Unit]
Description=Prism malware-analysis web frontend
Documentation=https://github.com/atomdrift-project/prism
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=prism
DynamicUser=yes
ExecStart=/usr/local/bin/prism --public
WorkingDirectory=/var/cache/prism
EnvironmentFile=/etc/prism/prism.env
Environment=HOME=/var/cache/prism
Environment=PGPASSFILE=%d/pgpass
Environment=PRISM_CSRF_KEY_FILE=%d/csrf-key
LoadCredential=pgpass:/etc/prism/pgpass
LoadCredential=csrf-key:/etc/prism/csrf-key

# fido's persistent cache is the only writable on-disk application path.
CacheDirectory=prism
CacheDirectoryMode=0700
ReadWritePaths=/var/cache/prism

Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM
KillMode=mixed
UMask=0077
LimitNOFILE=65536
TasksMax=512

# The service needs outbound TCP/DNS and one TCP listener, but no privilege.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindAllow=ipv4:tcp:8080
SocketBindDeny=any
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# Filesystem, kernel, process, device, namespace, and IPC isolation.
ProtectSystem=strict
ProtectHome=yes
NoExecPaths=/
ExecPaths=/usr/local/bin/prism
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
PrivateIPC=yes
PrivateMounts=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
KeyringMode=private
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
